VITE_GRAPHQL_ENDPOINT=http://localhost:3001/api/
VITE_STATIC_ASSETS_ENDPOINT=/resources/
# Broker credentials are NOT set here — they are served at runtime on the
# GraphQL `Stage.mqtt` field. Set MQTT_USER / MQTT_PASSWORD on the backend.
VITE_MQTT_NAMESPACE=dev
VITE_MQTT_ENDPOINT=ws://localhost:9001
#VITE_MQTT_ENDPOINT=wss://mqtt-dev.upstage.live:443
# Streaming servers. Each variable takes ONE OR MORE server URLs; several URLs
# are comma-separated on one line, e.g.
#   VITE_JITSI_ENDPOINTS=https://streaming.example.org,https://streaming3.example.org
# The first URL is the default server. Bare origins only (no path); spaces
# around the commas are ignored. With 2+ URLs performers pick a Jitsi server
# on stage, and a stream feed is bound to an RTMP server when it is created.
# Build-time: rebuild + deploy to apply.
VITE_JITSI_ENDPOINTS=http://localhost/
# MediaMTX playback origin(s) for RTMP stream feeds. Leave empty to hide all
# RTMP features.
VITE_RTMP_ENDPOINTS=
VITE_CLOUDFLARE_CAPTCHA_SITEKEY=
VITE_STRIPE_KEY=
VITE_RELEASE_VERSION='3.0.0'
VITE_ALIAS_RELEASE_VERSION='Build 001'
VITE_ENV_TYPE=dev
VITE_E2E=1


VITE_GRAPHQL_ENDPOINT=http://localhost:9090/api/
VITE_STATIC_ASSETS_ENDPOINT=/resources/
# Broker credentials are NOT set here. They are served at runtime on the
# GraphQL `Stage.mqtt` field so they never reach the public JS bundle; set
# MQTT_USER / MQTT_PASSWORD on the backend instead. Adding VITE_MQTT_USERNAME
# or VITE_MQTT_PASSWORD back here would have no effect on the app and would
# re-expose the secret if anything ever referenced it.
VITE_MQTT_NAMESPACE=dev
VITE_MQTT_ENDPOINT=ws://localhost:9001
#VITE_MQTT_ENDPOINT=wss://mqtt-dev.upstage.live
VITE_JITSI_ENDPOINT=http://localhost/
# MediaMTX playback origin for RTMP stream feeds (streaming2). Leave unset to
# hide all RTMP features.
VITE_RTMP_ENDPOINT=
VITE_CLOUDFLARE_CAPTCHA_SITEKEY=
VITE_STRIPE_KEY=
VITE_RELEASE_VERSION='3.0.0'
VITE_ALIAS_RELEASE_VERSION='Build 001'
VITE_ENV_TYPE=Production # Set to anything else to turn off CloudFlare captcha, CORS restrictions.
VITE_E2E=1 # exposes window.__UPSTAGE_PINIA__ for Playwright e2e; safe to leave on for dev/test, drop for hardened prod
LOCAL_SERVE_STATIC_CONTENT=/app_code_<site>/uploads/ # only for local testing

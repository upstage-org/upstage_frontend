# Copy to `.env` and adjust. Vite injects VITE_* at build / dev.
#
# GraphQL: use the SAME host/port as the Vite dev app (e.g. :3000), path `/api/`.
# The dev server proxies `/api` to the studio API (see `vite.config.ts`).
# Never set this to :3001 for the SPA — the browser would bypass the proxy.
# Leave unset to use `window.location.origin` + `/api/` (see `src/config.ts`).

VITE_GRAPHQL_ENDPOINT=http://localhost:3000/api/
VITE_STATIC_ASSETS_ENDPOINT=/resources/
# Broker credentials are NOT set here — they are served at runtime on the
# GraphQL `Stage.mqtt` field. Set MQTT_USER / MQTT_PASSWORD on the backend.
VITE_MQTT_NAMESPACE=dev
VITE_MQTT_ENDPOINT=ws://localhost:9001
# Streaming servers. Each variable takes ONE OR MORE server URLs; several URLs
# are comma-separated on one line, e.g.
#   VITE_JITSI_ENDPOINTS=https://streaming.example.org,https://streaming3.example.org
# The first URL is the default server. Bare origins only (no path); spaces
# around the commas are ignored. With 2+ URLs performers pick a Jitsi server
# on stage, and a stream feed is bound to an RTMP server when it is created.
# Build-time: rebuild + deploy to apply.
VITE_JITSI_ENDPOINTS=http://localhost/
# MediaMTX playback origin(s) for RTMP stream feeds. Leave empty to hide all
# RTMP features.
VITE_RTMP_ENDPOINTS=
# Optional overrides when the server's config.js cannot be loaded (lib-jitsi-meet path).
# Production streaming.upstage.live uses muc.streaming.upstage.live (not conference.*).
# VITE_JITSI_XMPP_DOMAIN=streaming.upstage.live
# VITE_JITSI_XMPP_MUC_DOMAIN=muc.streaming.upstage.live
VITE_CLOUDFLARE_CAPTCHA_SITEKEY=
VITE_STRIPE_KEY=
VITE_RELEASE_VERSION=2026.05.05
VITE_ALIAS_RELEASE_VERSION=84a231c
VITE_ENV_TYPE=dev
# Exposes window.__UPSTAGE_PINIA__ for the Playwright e2e suites (perform +
# features). `pnpm dev` already exposes it via DEV mode.
VITE_E2E=1
